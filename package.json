{
  "name": "royalforge",
  "version": "1.0.27",
  "description": "Batch edit TikTok Shop videos",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win"
  },
  "keywords": [],
  "author": "RoyalForge",
  "license": "ISC",
  "devDependencies": {
    "electron": "^24.0.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.royalforge.app",
    "productName": "RoyalForge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "font.ttf",
      "!app/fonts"
    ],
    "extraResources": [
      {
        "from": "fonts",
        "to": "fonts"
      },
      {
        "from": "fonts",
        "to": "app/fonts"
      },
      {
        "from": "ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "app/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "app/icon.ico",
      "uninstallerIcon": "app/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "app/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "bi372",
      "repo": "reelforge"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
